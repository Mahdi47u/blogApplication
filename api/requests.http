### GET request to example server
GET http://localhost:8080/api/users

###

### LOGIN (Get JWT)
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "username": "moein",
  "password": "admin7710"
}

### Get my user profile
GET http://localhost:8080/api/users/me
Authorization: Bearer {{token}}

### Update my bio
PUT http://localhost:8080/api/users/me/bio
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "bio": "Hello, I am Mahdi from IntelliJ REST client!"
}

### Upload profile picture
POST http://localhost:8080/api/users/me/profile-picture
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=WebAppBoundary

--WebAppBoundary
Content-Disposition: form-data; name="file"; filename="profile.jpg"
Content-Type: image/jpeg

< C:\Users\Mahdi_PC\Desktop\tum tum tum sahor.jpg
--WebAppBoundary--

### Change password
PUT http://localhost:8080/api/users/me/password
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "oldPassword": "admin8810",
  "newPassword": "admin7710"
}

### ADMIN: Get all users
GET http://localhost:8080/api/admin/users
Authorization: Bearer {{token}}

### ADMIN: Update user role
PUT http://localhost:8080/api/superadmin/users/1/role/ADMIN
Authorization: Bearer {{token}}
Content-Type: application/json

###
### =========================================================
### CREATE ROOT COMMENT
### =========================================================

POST http://localhost:8080/api/comments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "postId": 1,
  "text": "This post is really helpful!"
}

###
### =========================================================
### CREATE REPLY
### =========================================================

POST http://localhost:8080/api/comments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "postId": 1,
  "parentId": 1,
  "text": "I agree with your comment!"
}

###

### =========================================================
### GET ROOT COMMENTS (PAGINATED)
### =========================================================

GET http://localhost:8080/api/comments/post/1?page=0&size=5&sort=createdAt,desc

###

### Expected Response

### =========================================================
### GET REPLIES
### =========================================================

GET http://localhost:8080/api/comments/1/replies?page=0&size=5&sort=createdAt,asc

###
### =========================================================
### UPDATE COMMENT
### =========================================================

PUT http://localhost:8080/api/comments/1
Authorization: Bearer YOUR_JWT_TOKEN
Content-Type: application/json

{
  "text": "Updated comment text!"
}

###
### =========================================================
### DELETE COMMENT
### =========================================================

DELETE http://localhost:8080/api/comments/1
Authorization: Bearer YOUR_JWT_TOKEN

###
### =========================================================
### LIKE COMMENT
### =========================================================

POST http://localhost:8080/api/comment-likes/2
Authorization: Bearer YOUR_JWT_TOKEN

###
### =========================================================
### UNLIKE COMMENT
### =========================================================

DELETE http://localhost:8080/api/comment-likes/2
Authorization: Bearer YOUR_JWT_TOKEN
